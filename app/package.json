{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/generate-version.mjs && vite",
    "build": "node ../scripts/generate-version.mjs && tsc -b && vite build",
    "lint": "oxlint",
