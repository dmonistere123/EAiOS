# EAiOS runtime environment (copy to .env.local and fill in real values)
# This file is gitignored and never reaches the browser bundle.

# === REQUIRED ===

# Hermes integration — auto-generated by the installer
# Get your token from the Hermes desktop app or `hermes config get gateway.token`
VITE_HERMES_LIVE=1
VITE_HERMES_TOKEN=your_hermes_token_here

# Composio connector key — required for Connections/Composio integrations
# Get it at: https://app.composio.dev
# Sign in -> Settings -> API Keys -> Create key
COMPOSIO_API_KEY=your_composio_api_key_here

# === OPTIONAL ===

# Duffel flight search — optional, enables live flight search in Travel module
# Get it at: https://app.duffel.com/ -> Settings -> API Tokens
# DUFFEL_API_KEY=your_duffel_api_key_here

# OpenTable integration — optional, enables restaurant bookings
# Requires a business agreement with OpenTable. Contact their partner team.
# OPENTABLE_API_KEY=your_opentable_api_key_here

# Display name for the orchestration agent in the EAiOS UI (default: Ally)
VITE_AGENT_NAME=Ally