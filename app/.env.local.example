# EAiOS runtime environment (copy to .env.local and fill in real values)
# This file is gitignored and never reaches the browser bundle.

# Hermes integration — required
# Get your token from the Hermes desktop app or `hermes config get gateway.token`
VITE_HERMES_LIVE=1
VITE_HERMES_TOKEN=your_hermes_gateway_token_here

# Composio connector key — required for Connections/Composio integrations
COMPOSIO_API_KEY=your_composio_api_key_here

# Duffel flight search — optional, enables live flight results
DUFFEL_API_KEY=your_duffel_api_key_here

# Display name for the orchestration agent in the EAiOS UI (default: Ally)
VITE_AGENT_NAME=Ally
