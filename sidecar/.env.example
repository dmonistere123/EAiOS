# EAiOS sidecar environment — copy to sidecar/.env and fill in real values.
# This file is gitignored; it contains provider keys used only by the
# Python sidecar (Podcasts / document-to-podcast generation).
#
# The systemd start script (scripts/start-knowledge-sidecar.sh) sources this
# file before launching the sidecar, so changes require a service restart:
#   systemctl --user restart eaios-knowledge-sidecar

# OpenRouter is the default LLM provider for Podcastfy script generation.
# It is usually inherited from ~/.hermes/.env, but you may set it here too.
# OPENROUTER_API_KEY=

# ElevenLabs premium TTS — optional. If set, the UI can choose ElevenLabs voices.
# ELEVENLABS_API_KEY=

# OpenAI TTS — optional. Enables the OpenAI provider in the Podcasts page.
# OPENAI_API_KEY=

# Google Podcast API (Gemini Notebook Enterprise) — optional and currently
# blocked for new projects without the Gemini Notebook Enterprise entitlement.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/home/<user>/.gcp/<service-account>.json
# GOOGLE_PODCAST_ACCESS_TOKEN=

# Podcast generation defaults.
# EAIOS_PODCAST_LLM=openrouter/deepseek-v4-flash
# EAIOS_PODCAST_TTS=edge
# EAIOS_PODCAST_API_KEY_LABEL=OPENROUTER_API_KEY
