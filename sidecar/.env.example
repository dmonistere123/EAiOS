# EAiOS knowledge sidecar environment.
# Fill in provider keys to enable Podcasts with premium voices.

# ElevenLabs API key — enables ElevenLabs TTS voice options in Podcasts
# Get your key at: https://elevenlabs.io/app/settings/docs#api-key
# ELEVENLABS_API_KEY=your_elevenlabs_key_here

# OpenAI API key — enables OpenAI TTS voice options in Podcasts
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here

# Google Cloud credentials — enable Google NotebookLM Enterprise podcast generation
# Requires a GCP project with Discovery Engine API and Gemini Notebook Enterprise.
# See https://docs.cloud.google.com/gemini/enterprise/notebooklm-enterprise/docs
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json